# ===== Database (SQLite) =====
DATABASE_URL="file:./dev.db"

# ===== Tự động đăng bài theo lịch =====
# Vòng lặp đăng bài chạy sẵn TRONG app web (không cần mở terminal).
# Đặt 0 nếu muốn tự quản bằng cron/worker bên ngoài:
# SCHEDULER_IN_PROCESS=0
# Chu kỳ kiểm tra bài đến hạn, tính bằng mili giây (mặc định 60000 = 1 phút)
# WORKER_INTERVAL_MS=60000

# ===== Chế độ tự động (trang /autopilot) =====
# Chu kỳ bộ lập kế hoạch tự viết bài mới, tính bằng mili giây (mặc định 300000 = 5 phút).
# Bộ lập kế hoạch chạy chung vòng lặp với worker nhưng KHÔNG chặn việc đăng bài.
# PLANNER_INTERVAL_MS=300000

# Khóa bảo vệ endpoint /api/cron/tick. Tạo bằng: openssl rand -base64 32
# Nếu để trống, endpoint chỉ nhận request từ máy cục bộ (loopback).
CRON_SECRET=""

# Địa chỉ web server mà worker gọi tới (mặc định http://localhost:3000)
# APP_URL="http://localhost:3000"
# Chu kỳ worker kiểm tra bài đến hạn, tính bằng mili giây (mặc định 60000 = 1 phút)
# WORKER_INTERVAL_MS=60000

# ===== Session =====
# Khóa ký JWT session — tạo bằng: openssl rand -base64 32
SESSION_SECRET=""
SESSION_COOKIE_NAME="session"

# Tài khoản admin đầu tiên (tham khảo — khuyến nghị dùng trang /setup)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# ===== AI (nhà cung cấp thứ 3 tương thích OpenAI) =====
# Ví dụ: https://api.openai.com/v1 hoặc URL nhà cung cấp của bạn
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""

# ===== Pexels =====
# Đăng ký miễn phí: https://www.pexels.com/api/
PEXELS_API_KEY=""

# Chỉ dùng khi test: trỏ Pexels về server giả thay vì https://api.pexels.com
# PEXELS_BASE_URL="http://127.0.0.1:4030"

# ===== Video tải lên từ máy =====
# Thư mục lưu video người dùng tải lên (mặc định: ./uploads)
# UPLOAD_DIR="/duong/dan/tuyet-doi/uploads"
# Giới hạn dung lượng mỗi video, tính bằng byte (mặc định 200MB)
# MAX_VIDEO_BYTES=209715200

# ===== Facebook Graph API =====
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_GRAPH_VERSION="v21.0"

# Chỉ dùng khi test: trỏ Graph API về server giả thay vì Facebook thật.
# Để trống/không khai báo = dùng https://graph.facebook.com
# FB_GRAPH_BASE_URL="http://127.0.0.1:4020"
