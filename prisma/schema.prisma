// Prisma schema — Facebook Marketing Automation App
// Lưu ý: các trạng thái dùng String (không dùng enum) để giữ mô hình dữ liệu
// đơn giản và không phải migrate enum mỗi khi thêm giá trị mới.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AppSetting {
  key       String   @id // ví dụ: "ai.baseUrl", "facebook.appId"
  value     String // đã mã hóa AES-256-GCM trước khi lưu
  group     String // "AI" | "PEXELS" | "FACEBOOK"
  updatedAt DateTime @db.Timestamptz(3) @updatedAt
  createdAt DateTime @db.Timestamptz(3) @default(now())
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String // bcrypt hash
  role      String   @default("ADMIN") // ADMIN | USER
  /// Quản trị tài khoản: null = kế thừa (không ràng buộc) | PENDING | APPROVED | REJECTED.
  /// Role ADMIN bỏ qua kiểm tra này.
  status             String?
  /// Bật khi admin cấp mật khẩu tạm — buộc đổi mật khẩu ngay lần đăng nhập đầu.
  mustChangePassword Boolean  @default(false)
  passwordChangedAt  DateTime? @db.Timestamptz(3)
  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  pages      FacebookPage[]
  posts      Post[]
  media      Media[]
  brands     BrandProfile[]
  pillars    ContentPillar[]
  docs       KnowledgeDoc[]
  autopilots AutoPilot[]

  // ---- Đa workspace ----
  workspaces       Workspace[] // workspace user sở hữu (owner)
  workspaceMembers WorkspaceMember[]
  facebookCreated  FacebookConnection[]

  // ---- Thông báo & cấu hình & tài liệu ----
  notifications Notification[]
  userSettings  UserSetting[]
  docsWritten   Doc[]
  questionsAsked FeedbackQuestion[]
  answersGiven   FeedbackAnswer[]

  // ---- Nguồn media: Google Drive cá nhân (xem DriveConnection) ----
  driveConnection DriveConnection?
}

// ============================================================
// WORKSPACE — tenant chính của hệ thống.
//
// Một user có thể tạo/tham gia nhiều workspace. Mọi dữ liệu nghiệp vụ
// (Page, Brand, Post, Media, AutoPilot, Facebook Connection) đều thuộc
// một workspace để cách ly dữ liệu giữa các "góc làm việc".
// ============================================================

model Workspace {
  id        String   @id @default(cuid())
  name      String // tên hiển thị, ví dụ "Cửa hàng A"
  slug      String   @unique // dùng trong URL /w/[slug]/...
  timezone  String   @default("Asia/Ho_Chi_Minh")
  /// ACTIVE | ARCHIVED
  status    String   @default("ACTIVE")
  ownerId   String
  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  owner   User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members WorkspaceMember[]
  fbApps  FacebookConnection[]
  pages   FacebookPage[]
  brands  Brand[]
  posts   Post[]
  media   Media[]

  @@index([ownerId])
}

/// Thành viên workspace. OWNER có mọi quyền; các role khác dùng dần.
model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  /// OWNER | ADMIN | EDITOR | VIEWER
  role        String   @default("OWNER")
  createdAt   DateTime @db.Timestamptz(3) @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ============================================================
// FACEBOOK CONNECTION — một bộ Facebook Graph API App trong workspace.
//
// Một Facebook App chỉ cấp token cho một số Page giới hạn, nên mỗi
// workspace có thể thêm NHIỀU connection (App ID + Secret + user token
// riêng) để lấy được các nhóm Page khác nhau. Mỗi Page ghi nhớ
// connectionId đã dùng để đồng bộ/đăng bài bằng đúng App đó.
// ============================================================

model FacebookConnection {
  id              String    @id @default(cuid())
  workspaceId     String
  /// Tên gợi nhớ do người dùng đặt, ví dụ "App Shop Chính"
  name            String
  appId           String
  /// Đã mã hóa AES-256-GCM (encryptValue trong lib/settings.ts)
  appSecret       String
  /// User Access Token long-lived — đã mã hóa AES-256-GCM
  userAccessToken String
  graphVersion    String    @default("v21.0")
  /// ACTIVE | EXPIRED | ERROR | DISABLED
  status          String    @default("ACTIVE")
  tokenExpiresAt  DateTime? @db.Timestamptz(3)
  lastValidatedAt DateTime? @db.Timestamptz(3)
  lastSyncedAt    DateTime? @db.Timestamptz(3)
  lastError       String?
  createdById     String
  createdAt       DateTime  @db.Timestamptz(3) @default(now())
  updatedAt       DateTime  @db.Timestamptz(3) @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  pages     FacebookPage[]

  @@unique([workspaceId, appId])
  @@index([workspaceId, status])
}

// ============================================================
// BRAND — thương hiệu trong workspace.
//
// Một workspace quản lý nhiều thương hiệu; một thương hiệu có thể có
// nhiều Page. Hồ sơ thương hiệu (BrandProfile), trụ cột nội dung và
// kho tài liệu gắn với Brand để dùng chung giữa các Page cùng thương hiệu.
// ============================================================

model Brand {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  /// ACTIVE | ARCHIVED
  status      String   @default("ACTIVE")
  description String?
  createdAt   DateTime @db.Timestamptz(3) @default(now())
  updatedAt   DateTime @db.Timestamptz(3) @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pages     FacebookPage[]
  profile   BrandProfile?
  pillars   ContentPillar[]
  docs      KnowledgeDoc[]
  posts     Post[]
  /// Thư mục Google Drive chứa ảnh/video riêng của thương hiệu (chọn qua Picker)
  driveFolder BrandDriveFolder?

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
}

model FacebookPage {
  id             String    @id @default(cuid())
  userId         String
  /// Workspace sở hữu Page (backfill từ user đầu tiên)
  workspaceId    String
  /// Connection (Facebook App) đã đồng bộ Page này — dùng đúng App khi đăng
  connectionId   String?
  /// Thương hiệu Page thuộc về (nullable để migration dần dần)
  brandId        String?
  fbPageId       String // ID Page trên Facebook — unique theo workspace
  name           String
  category       String?
  avatarUrl      String?
  accessToken    String // Page Access Token (long-lived, đã mã hóa khi lưu)
  tokenExpiresAt DateTime? @db.Timestamptz(3) // ngày hết hạn token (nếu biết)
  isActive       Boolean   @default(true)

  // ---- Số liệu hiệu quả (Insights) ----
  /// UNKNOWN | OK | PARTIAL | NO_PERMISSION | LOW_FANS | TOKEN_INVALID | ERROR
  insightsStatus        String    @default("UNKNOWN")
  insightsLastFetchedAt DateTime? @db.Timestamptz(3)
  insightsLastError     String?

  createdAt      DateTime  @db.Timestamptz(3) @default(now())
  updatedAt      DateTime  @db.Timestamptz(3) @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection FacebookConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  brand      Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  posts      Post[]

  pillars   ContentPillar[]
  docs      KnowledgeDoc[]
  autopilot AutoPilot?
  usedMedia UsedMedia[]

  // ---- Số liệu hiệu quả & học từ số liệu ----
  insights   PostInsight[]
  snapshots  PageInsightSnapshot[]
  probeLog   ProbeEntry[]
  directions ContentDirection[]

  @@unique([workspaceId, fbPageId])
  @@index([connectionId])
  @@index([workspaceId, brandId])
}

model Post {
  id           String    @id @default(cuid())
  userId       String
  /// Workspace sở hữu bài viết
  workspaceId  String
  /// Thương hiệu bài viết thuộc về (nullable — lọc/báo cáo theo Brand)
  brandId      String?
  pageId       String?
  content      String // nội dung caption
  /// Ý chính của bài (câu đầu tiên) — AI trả về riêng để hiển thị và kiểm tra
  /// chất lượng. Null với bài cũ hoặc khi model không trả về trường này.
  hook         String?
  hashtags     String? // hashtag cách nhau bởi dấu cách
  linkUrl      String? // link đính kèm (nếu có)
  status       String    @default("DRAFT") // DRAFT | PENDING_REVIEW | SCHEDULED | PUBLISHING | PUBLISHED | FAILED
  errorMessage String? // lỗi khi đăng (nếu có)
  fbPostId     String? // ID bài đăng trên Facebook sau khi đăng thành công
  scheduledAt  DateTime? @db.Timestamptz(3) // thời điểm hẹn đăng (Schedule tích hợp trong Post)
  publishedAt  DateTime? @db.Timestamptz(3) // thời điểm đăng thực tế

  // ---- Nguồn gốc bài đăng ----
  origin     String  @default("MANUAL") // MANUAL (người dùng soạn) | AUTOPILOT (hệ thống tự tạo)
  pillarName String? // trụ cột nội dung đã dùng (để xoay vòng và hiển thị)
  topic      String? // chủ đề AI đã viết (với bài tự động)
  /// Địa bàn bài này đã nhắm (lấy từ BrandProfile.serviceAreas). Null = bài
  /// không gắn địa bàn (thương hiệu để trống, hoặc bài cũ trước khi có tính năng).
  /// Dùng để xoay vòng và hiển thị cho người dùng thấy vòng xoay đang chạy.
  serviceArea String?

  // ---- Trạng thái worker tự động đăng (Tuần 6) ----
  attempts      Int       @default(0) // số lần đã thử đăng
  lastAttemptAt DateTime? @db.Timestamptz(3) // lần thử gần nhất
  nextAttemptAt DateTime? @db.Timestamptz(3) // thời điểm thử lại sau lỗi (backoff)
  lockedAt      DateTime? @db.Timestamptz(3) // worker đang giữ bài này (chống 2 worker đăng trùng)

  // ---- Học từ số liệu (Insights) ----
  /// STANDARD = bài thường | PROBE = bài dò để tìm hướng đi ban đầu.
  /// Đếm từ cột này (nguồn sự thật) chứ không dùng bộ đếm có thể lệch.
  probeKind String @default("STANDARD")
  /// Ghi chú ngắn về tối ưu đã áp cho bài này, ví dụ
  /// "Dò: hook Danh sách · band Tối 18–22h". Null = chưa bật tối ưu theo số liệu.
  optimizationNote String?

  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  page      FacebookPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)
  media     Media[]
  insight   PostInsight?

  // Truy vấn bài đến hạn của worker: lọc theo status + scheduledAt
  @@index([status, scheduledAt])
  @@index([status, nextAttemptAt])
  // Đếm bài đã lên kế hoạch theo Page + ngày (bộ lập kế hoạch tự động)
  @@index([pageId, origin, scheduledAt])
  // Đếm bài đã đăng để suy ra giai đoạn học (PROBE/EXPLOIT)
  @@index([pageId, origin, status, publishedAt])
  // Lọc theo workspace / brand cho đa tenant
  @@index([workspaceId, status, scheduledAt])
  @@index([workspaceId, brandId])
}

model Media {
  id              String   @id @default(cuid())
  postId          String? // null = ảnh trong thư viện, chưa gắn vào bài nào
  userId          String? // chủ sở hữu (ảnh thư viện lưu theo user)
  /// Workspace sở hữu media (thư viện cách ly theo workspace)
  workspaceId     String?
  type            String // IMAGE | VIDEO
  /// PEXELS (kho ảnh stock) | URL (link ngoài) | UPLOAD (tải từ máy) | DRIVE (Google Drive cá nhân)
  source          String   @default("PEXELS")
  /// URL file gốc. Với DRIVE: đường dẫn nội bộ "/api/drive/<driveFileId>" (có kiểm quyền).
  remoteUrl       String // URL file gốc (Pexels hoặc nơi lưu trữ)
  previewUrl      String? // URL ảnh xem trước
  width           Int?
  height          Int?
  duration        Int? // giây (chỉ video)
  position        Int      @default(0) // thứ tự hiển thị trong bài
  // ---- Thông tin nguồn (Pexels) để ghi công tác giả ----
  /// ID ảnh/video trên Pexels; với source = DRIVE thì đây là fileId trên Google Drive.
  providerId      String?
  photographer    String?
  photographerUrl String?
  sourcePageUrl   String?
  alt             String?
  // ---- File upload từ máy người dùng (video) ----
  storageKey      String? // tên file trong thư mục uploads/<userId>/
  mimeType        String?
  sizeBytes       Int?
  /// Với source = DRIVE: thư mục Drive chứa tệp này.
  /// Dùng để lọc "ảnh thuộc thư mục của thương hiệu" khi AutoPilot chọn ảnh —
  /// không phải gọi Drive lại mỗi lần lập kế hoạch.
  driveFolderId   String?
  createdAt       DateTime @db.Timestamptz(3) @default(now())

  post      Post?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([postId])
  @@index([workspaceId])
}

// ============================================================
// GOOGLE DRIVE — nguồn media cá nhân của người dùng.
//
// Ý tưởng: thay vì dồn mọi ảnh/video vào Supabase Storage (1 GB ở gói
// Free), để mỗi người dùng dùng Drive của chính họ (15 GB). App chỉ nối
// vào và đọc — dung lượng tăng theo số người dùng, không đè lên hạn mức
// của hệ thống.
//
// Quyền dùng "drive.file" (scope không nhạy cảm, không cần Google duyệt):
// app CHỈ thấy file do app tạo hoặc do người dùng chọn qua Google Picker.
// Vì vậy mỗi thương hiệu cần một thư mục do người dùng chọn (BrandDriveFolder).
//
// Token mã hóa AES-256-GCM bằng encryptValue (lib/settings.ts) — giống
// FacebookConnection, KHÔNG bao giờ lộ ra client.
// ============================================================

model DriveConnection {
  id                   String    @id @default(cuid())
  /// Mỗi người dùng một kết nối Drive (tài sản riêng, như AI/Pexels key).
  userId               String    @unique
  /// Email Google đã cấp quyền — để hiển thị "đang nối vào tài khoản nào".
  googleEmail          String?
  /// Scope đã được cấp (thường là "openid email profile .../drive.file").
  scope                String
  /// Refresh token — đã mã hóa AES-256-GCM.
  refreshToken         String
  /// Access token (ngắn hạn) — đã mã hóa; tự làm mới khi gần hết hạn.
  accessToken          String?
  accessTokenExpiresAt DateTime? @db.Timestamptz(3)
  /// Thư mục gốc người dùng chọn làm nơi chứa thư mục của các thương hiệu.
  rootFolderId         String?
  /// ACTIVE | NEEDS_REAUTH (token bị thu hồi/hết hạn) | DISABLED
  status               String    @default("ACTIVE")
  lastError            String?
  lastRefreshedAt      DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @db.Timestamptz(3) @default(now())
  updatedAt            DateTime  @db.Timestamptz(3) @updatedAt

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  brands BrandDriveFolder[]

  @@index([status])
}

/// Thư mục Drive của MỘT thương hiệu — nguồn ảnh/video riêng cho Brand đó.
model BrandDriveFolder {
  id           String    @id @default(cuid())
  brandId      String    @unique
  /// null = người dùng đã ngắt kết nối Drive (giữ folderId để nối lại đúng thư mục cũ).
  connectionId String?
  folderId     String
  /// Tên thư mục, cache lại để hiển thị được cả khi Drive tạm lỗi.
  folderName   String?
  /// Cho phép AutoPilot dùng video trong thư mục này (tắt = chỉ lấy ảnh).
  allowVideo   Boolean   @default(true)
  lastSyncedAt DateTime? @db.Timestamptz(3)
  lastError    String?
  createdAt    DateTime  @db.Timestamptz(3) @default(now())
  updatedAt    DateTime  @db.Timestamptz(3) @updatedAt

  brand      Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  connection DriveConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([connectionId])
}

// ============================================================
// HỒ SƠ THƯƠNG HIỆU — "tài liệu cơ bản về trang Facebook"
//
// Đây là nơi người dùng mô tả doanh nghiệp MỘT LẦN. Mọi nội dung AI
// viết ra (thủ công lẫn tự động) đều dựa trên hồ sơ này, nhờ đó bài
// đăng đúng ngành hàng, đúng khách hàng, đúng giọng điệu thương hiệu
// thay vì chung chung.
// ============================================================

model BrandProfile {
  id           String   @id @default(cuid())
  userId       String
  /// Brand sở hữu hồ sơ (mỗi Brand một hồ sơ)
  brandId      String   @unique
  // ---- Thông tin cơ bản về doanh nghiệp ----
  brandName    String? // tên thương hiệu (mặc định lấy tên Page)
  tagline      String? // slogan / câu định vị
  description  String? // giới thiệu doanh nghiệp vài câu
  industry     String? // ngành hàng, ví dụ "Nội thất - rèm cửa"
  products     String? // sản phẩm/dịch vụ chính, mỗi dòng một mục
  usp          String? // điểm khác biệt so với đối thủ
  priceRange   String? // khoảng giá để AI không bịa giá
  audience     String? // khách hàng mục tiêu
  /// Địa bàn hoạt động, mỗi dòng một mục (ví dụ "Thủ Dầu Một", "Dĩ An").
  ///
  /// KHÔNG bắt buộc. AutoPilot xoay vòng mỗi bài nhắm một địa bàn để phủ từ
  /// khoá địa phương. AI CHỈ được nhắc đúng những tên có trong danh sách này —
  /// tên phường/xã ở Việt Nam thay đổi nhiều sau các đợt sáp nhập, để AI tự
  /// sinh tên sẽ dễ ra địa danh sai hoặc không còn tồn tại.
  serviceAreas String?
  // ---- Liên hệ (AI được phép dùng đúng những gì nhập ở đây) ----
  address      String?
  phone        String?
  website      String?
  // ---- Giọng điệu & quy tắc viết ----
  tone         String   @default("friendly") // friendly|professional|exciting|inspiring|humorous
  avoidTopics  String? // điều TUYỆT ĐỐI không nhắc tới
  signatureCta String? // câu kêu gọi hành động quen thuộc
  baseHashtags String? // hashtag luôn dùng cho Page này
  samplePosts  String? // vài bài viết mẫu để AI bắt chước văn phong
  notes        String? // ghi chú thêm cho AI
  createdAt    DateTime @db.Timestamptz(3) @default(now())
  updatedAt    DateTime @db.Timestamptz(3) @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

/// Trụ cột nội dung: các "loại bài" cần xoay vòng để Page không nhàm chán.
/// weight là tỉ trọng % — bộ lập kế hoạch dùng để chọn loại bài cho mỗi slot.
model ContentPillar {
  id          String   @id @default(cuid())
  userId      String
  /// Brand sở hữu trụ cột (dùng chung cho các Page cùng thương hiệu)
  brandId     String
  /// Giữ lại cho dữ liệu cũ; nội dung trụ cột giờ thuộc Brand
  pageId      String?
  name        String // ví dụ "Giới thiệu sản phẩm"
  description String? // hướng dẫn cách viết loại bài này
  goal        String   @default("engagement") // engagement|sales|awareness|education
  weight      Int      @default(25) // tỉ trọng tương đối
  enabled     Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @db.Timestamptz(3) @default(now())
  updatedAt   DateTime @db.Timestamptz(3) @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  page  FacebookPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([brandId, enabled])
}

/// Kho tài liệu: bảng giá, câu hỏi thường gặp, chính sách, câu chuyện
/// thương hiệu... AI đọc những tài liệu này để viết đúng sự thật.
model KnowledgeDoc {
  id        String   @id @default(cuid())
  userId    String
  /// Brand sở hữu tài liệu (dùng chung cho các Page cùng thương hiệu)
  brandId   String
  /// Giữ lại cho dữ liệu cũ; tài liệu giờ thuộc Brand
  pageId    String?
  title     String
  kind      String   @default("OTHER") // PRODUCT|PRICE|FAQ|POLICY|STORY|OTHER
  content   String
  enabled   Boolean  @default(true)
  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  page  FacebookPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([brandId, enabled])
}

// ============================================================
// CHẾ ĐỘ TỰ ĐỘNG — người dùng chỉ đặt thông số, hệ thống chạy liên tục.
//
// Bộ lập kế hoạch (src/lib/autopilot.ts) đọc bảng này, tự tạo đủ số bài
// cho vài ngày tới với giờ đăng nằm trong khung người dùng chọn, rồi để
// scheduler hiện có đăng chúng.
// ============================================================

model AutoPilot {
  id      String  @id @default(cuid())
  userId  String
  pageId  String  @unique // mỗi Page một cấu hình
  /// false = không tự tạo bài nào (vẫn giữ cấu hình để bật lại)
  enabled Boolean @default(false)
  /// AUTO = tạo bài rồi tự đăng khi tới giờ
  /// REVIEW = tạo bài ở trạng thái chờ duyệt, người dùng duyệt mới đăng
  mode    String  @default("REVIEW")

  // ---- Người dùng chỉ cần chọn mấy thông số này ----
  postsPerDay   Int    @default(2) // mỗi ngày đăng mấy bài
  windowStart   String @default("07:00") // khung giờ đăng: từ lúc nào...
  windowEnd     String @default("21:00") // ...đến lúc nào
  daysOfWeek    String @default("1,2,3,4,5,6,7") // 1=Thứ Hai … 7=Chủ Nhật
  minGapMinutes Int    @default(120) // khoảng cách tối thiểu giữa 2 bài

  // ---- Tự tìm ảnh/video ----
  autoMedia     Boolean @default(true)
  /// Nguồn chính để lấy ảnh/video: PEXELS (kho stock) | DRIVE (thư mục Drive của Brand).
  /// Người dùng chọn tự do; đổi nguồn không làm hỏng bài đã lên lịch.
  mediaPrimary  String  @default("PEXELS")
  /// true = nguồn chính hết ảnh/lỗi thì lấy tiếp từ nguồn còn lại.
  /// false = chỉ dùng đúng nguồn chính; thiếu ảnh thì chấp nhận bài không ảnh (có cảnh báo).
  mediaFallback Boolean @default(true)
  /// Giữ lại để tương thích với cấu hình cũ; mediaMix mới có quyền quyết định.
  mediaKind     String  @default("IMAGE") // IMAGE | VIDEO
  photosPerPost Int     @default(2)
  /// IMAGE_ONLY = mọi bài dùng ảnh
  /// VIDEO_ONLY = mọi bài dùng video
  /// MIXED      = luân phiên theo tỉ lệ videoPercent
  ///
  /// Facebook KHÔNG cho đăng chung ảnh và video trong cùng một bài, nên
  /// "xen kẽ" ở đây nghĩa là luân phiên GIỮA CÁC BÀI.
  mediaMix      String  @default("IMAGE_ONLY")
  /// Phần trăm số bài dùng video khi mediaMix = MIXED (0–100).
  videoPercent  Int     @default(25)

  // ---- Nội dung ----
  length        String  @default("medium") // short|medium|long
  toneOverride  String? // để trống = dùng giọng điệu của hồ sơ thương hiệu
  useHashtags   Boolean @default(true)
  planAheadDays Int     @default(2) // lên kế hoạch trước mấy ngày
  /// Mốc neo lập kế hoạch. null = bắt đầu từ hôm nay. Đặt ngày tương lai để
  /// hoãn, hoặc để bắt đầu lại từ một mốc sạch sau khi xoá bài cũ.
  startDate     DateTime? @db.Timestamptz(3)

  // ---- Sổ theo dõi để không lên kế hoạch trùng / không spam khi AI lỗi ----
  lastPlannedAt DateTime? @db.Timestamptz(3)
  lastPlanError String?
  lastPlanCount Int       @default(0) // số bài tạo ra ở lần lập kế hoạch gần nhất
  totalPlanned  Int       @default(0) // tổng số bài đã tạo từ trước tới nay

  // ---- Học từ số liệu (Insights) ----
  /// true = AutoPilot đọc số liệu bài đã đăng để tự điều chỉnh trụ cột/giờ/góc.
  /// Mặc định false: Page không bật thì lập kế hoạch y như trước.
  insightsEnabled Boolean @default(false)
  /// PROBE | EXPLOIT | REPROBE — suy ra được từ dữ liệu thật (Post + PostInsight);
  /// lưu cache để giao diện và thông báo nhất quán.
  learningPhase       String    @default("PROBE")
  /// null = chưa từng dò. Chỉ để ghi nhận/thông báo, KHÔNG dùng tính ngân sách.
  probeStartedAt      DateTime? @db.Timestamptz(3)
  /// Tổng số bài dò đã tạo (cache hiển thị; ngân sách đếm từ Post.probeKind).
  probeRedistributed  Int       @default(0)
  lastReProbeAt       DateTime? @db.Timestamptz(3)
  /// Kết luận/nhận xét gần nhất — CHỈ là cache, tái tạo được từ Post + PostInsight.
  learningConclusion  String?
  /// Kết luận suy ra lúc nào; quá LEARNING_SUMMARY_TTL_HOURS thì hiển thị "đang tính lại".
  learningComputedAt  DateTime? @db.Timestamptz(3)

  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  page FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

// ============================================================
// CHỐNG TRÙNG ẢNH GIỮA CÁC BÀI
//
// Pexels trả kết quả theo thứ tự phổ biến, nên cùng một từ khóa thường
// ra cùng vài tấm đầu. Nếu không ghi lại, Page sẽ đăng đi đăng lại vài
// tấm ảnh giống nhau. Bảng này ghi mọi ảnh/video đã dùng cho từng Page
// để bộ chọn media loại chúng ra.
//
// Chỉ lưu providerId (ID trên Pexels), không lưu file — rất nhẹ.
// ============================================================

model UsedMedia {
  id         String   @id @default(cuid())
  pageId     String
  /// ID ảnh/video trên Pexels
  providerId String
  type       String // IMAGE | VIDEO
  usedAt     DateTime @db.Timestamptz(3) @default(now())

  page FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  // Mỗi Page chỉ ghi một dòng cho mỗi ảnh
  @@unique([pageId, providerId])
  // Truy vấn "ảnh đã dùng trong 60 ngày gần đây"
  @@index([pageId, usedAt])
}

// ============================================================
// SỐ LIỆU HIỆU QUẢ CỦA BÀI ĐĂNG (Facebook Insights)
//
// VÌ SAO CẦN
// AutoPilot hiện chỉ biết "đã đăng" chứ không biết bài đó có được người
// xem hay không, nên nội dung dễ dậm chân tại chỗ hoặc sáo rỗng. Bảng này
// lưu số liệu thật của từng bài để bộ lập kế hoạch chọn trụ cột, khung giờ
// và góc trình bày cho các bài sau.
//
// PHÂN BIỆT 2 NHÓM SỐ LIỆU (rất quan trọng):
//   - reactions/comments/shares: chỉ cần quyền `pages_read_engagement`
//     (app đã có) → LUÔN lấy được.
//   - impressions/mediaView/videoViews/clicks: cần thêm `read_insights`
//     và Page phải đủ 100 lượt thích → có thể không có.
// Vì vậy mọi cột số liệu phân phối đều NULLABLE, và `status` ghi rõ vì sao
// thiếu. Khi thiếu, hệ thống vẫn xếp hạng được bằng tương tác — chỉ kém
// chính xác hơn và giao diện sẽ nói rõ điều đó.
//
// LƯU Ý VỀ DEPRECATION: các metric `*_unique` (post_impressions_unique,
// post_video_views_unique...) đã bị Meta ngừng hỗ trợ cho mọi phiên bản API
// từ 15/06/2026. Bảng này dùng metric thay thế (`post_media_view`,
// post_total_media_view_unique`) và giữ `post_impressions` (tổng) làm dự phòng.
// Danh sách metric nằm ở src/lib/insights-core.ts (INSIGHT_METRIC_GROUPS) —
// Meta đổi tiếp thì chỉ cần sửa một chỗ đó.
// ============================================================

model PostInsight {
  id          String   @id @default(cuid())
  /// Mỗi bài một dòng số liệu (upsert theo postId).
  postId      String   @unique
  /// Denormalize để truy vấn theo Page/workspace không phải join Post.
  pageId      String
  workspaceId String?
  fbPostId    String

  // ---- Phân phối: chỉ có khi token có `read_insights` ----
  /// post_impressions (tổng — chưa bị ngừng hỗ trợ)
  impressions     Int?
  /// post_media_view — metric thay thế cho "lượt hiển thị"
  mediaView       Int?
  /// post_total_media_view_unique — metric thay thế cho "số người tiếp cận"
  mediaViewUnique Int?
  /// post_video_views (chỉ bài video)
  videoViews      Int?
  /// post_video_avg_time_watched (mili giây)
  videoAvgTimeMs  Int?
  /// post_clicks
  clicks          Int?

  // ---- Tương tác: LUÔN có (chỉ cần pages_read_engagement) ----
  reactions Int @default(0)
  comments  Int @default(0)
  shares    Int @default(0)

  /// OK | PARTIAL | FRESH | NO_PERMISSION | ERROR
  /// - FRESH: bài chưa đủ 24h, Facebook chưa chốt số liệu → HIỂN THỊ nhưng
  ///   KHÔNG dùng để học (tránh học từ bài còn đang tăng).
  status         String  @default("OK")
  /// JSON mảng metric Facebook từ chối — để giao diện nói rõ đang thiếu gì.
  missingMetrics String?
  errorMessage   String?
  fetchedAt      DateTime @db.Timestamptz(3)
  createdAt      DateTime @db.Timestamptz(3) @default(now())
  updatedAt      DateTime @db.Timestamptz(3) @updatedAt

  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  page      FacebookPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, fetchedAt])
  @@index([workspaceId])
  @@index([pageId, status])
}

// ============================================================
// SỐ LIỆU CẤP PAGE THEO NGÀY
//
// Bổ sung bối cảnh mà số liệu từng bài không cho biết: Page đang tăng hay
// mất người theo dõi, tổng lượt xem/tiếp cận của Page, và người theo dõi
// tập trung ở đâu.
//
// `topCitiesJson` CHỈ ĐỂ HIỂN THỊ. Địa bàn dùng khi viết bài vẫn lấy từ
// BrandProfile.serviceAreas do người dùng nhập — đổi địa bàn theo dữ liệu
// Facebook sẽ khiến AI nhắc tên khu vực người dùng không phục vụ.
//
// dayKey là ngày theo LỊCH VIỆT NAM (formatDateKey) — không dùng ngày UTC,
// vì một ngày lệch 7 tiếng sẽ gộp nhầm hai ngày số liệu.
// ============================================================

model PageInsightSnapshot {
  id          String   @id @default(cuid())
  pageId      String
  workspaceId String?
  /// "YYYY-MM-DD" theo giờ Việt Nam
  dayKey      String

  fans            Int?
  follows         Int?
  pageImpressions Int?
  /// page_media_view
  mediaView       Int?
  /// page_total_media_view_unique
  mediaViewUnique Int?
  /// page_post_engagements
  postEngagements Int?
  /// page_views_total
  pageViewsTotal  Int?
  /// JSON [{ city, count }] — chỉ hiển thị
  topCitiesJson   String?

  missingMetrics String?
  /// OK | PARTIAL | NO_PERMISSION | LOW_FANS | TOKEN_INVALID | ERROR
  status         String  @default("OK")
  errorMessage   String?
  fetchedAt      DateTime @db.Timestamptz(3)
  createdAt      DateTime @db.Timestamptz(3) @default(now())
  updatedAt      DateTime @db.Timestamptz(3) @updatedAt

  page FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, dayKey])
  @@index([pageId, fetchedAt])
  @@index([workspaceId])
}

// ============================================================
// NHẬT KÝ DÒ TÌM HƯỚNG (Giai đoạn khám phá)
//
// Khi Page vừa bật tự động đăng, chưa có số liệu nào để học. Thay vì bám
// ngay vào một trụ cột (dễ sai và khó sửa về sau), hệ thống chạy một đợt
// "dò" có kiểm soát: phân bổ đều bài qua các trụ cột, 4 kiểu hook và các
// khung giờ trong ngày, rồi xem hướng nào được người xem đáp lại.
//
// Bảng này ghi TỪNG HƯỚNG đã thử để:
//   1. Lần dò sau không thử lại hướng đã thất bại (tránh lặp vô ích).
//   2. Giải thích được cho người dùng: "đã thử gì, kết quả ra sao".
//
// Mọi hướng ở đây đều NẰM TRONG hồ sơ thương hiệu: trụ cột lấy từ
// ContentPillar đang bật, kiểu hook từ bộ 4 kiểu đóng, khung giờ từ cấu
// hình người dùng đặt. Không có "chủ đề mới" nào được sinh ra.
// ============================================================

model ProbeEntry {
  id          String   @id @default(cuid())
  pageId      String
  workspaceId String?
  /// Đợt dò (PROBE đầu tiên hoặc một lần REPROBE) — nhóm lại để báo cáo.
  batchId     String
  /// PILLAR | HOOK | TIME_BAND | MEDIA | SERVICE_AREA
  kind        String
  /// Giá trị cụ thể đã thử: tên trụ cột, "DanhSach", "TOI"...
  value       String
  /// Số bài đã tạo cho hướng này trong đợt (cache; nguồn thật là Post.probeKind).
  postCount   Int     @default(0)
  /// PENDING | GOOD | BAD | NEUTRAL
  result      String  @default("PENDING")
  /// Hiệu quả trung bình của hướng (robust z so với trung vị Page). Null = chưa đủ mẫu.
  score       Float?
  notes       String?
  createdAt   DateTime @db.Timestamptz(3) @default(now())
  updatedAt   DateTime @db.Timestamptz(3) @updatedAt

  page FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  /// Mỗi hướng chỉ một dòng trong một đợt
  @@unique([pageId, batchId, kind, value])
  @@index([pageId, createdAt])
  @@index([workspaceId])
}

// ============================================================
// HƯỚNG NỘI DUNG ĐANG TRIỂN KHAI (phần "nhận xét")
//
// Đây là bảng trả lời trực tiếp câu hỏi của người dùng: "nội dung hiện tại
// đang triển khai theo hướng nào và số liệu ra sao?".
//
// Mỗi dòng = một hướng (một trụ cột, một kiểu hook, một khung giờ, một loại
// media, một địa bàn) kèm trạng thái sống/chết của nó. Dữ liệu được TÍNH LẠI
// từ Post + PostInsight mỗi lượt kiểm tra — bảng này chỉ là kết quả chiếu ra,
// không phải nguồn sự thật thứ hai.
//
// estLifeDays là ƯỚC LƯỢNG THÔ ngoại suy từ chính dữ liệu của Page (độ dốc
// của hiệu quả qua thời gian), KHÔNG phải dự báo của Facebook. Giao diện bắt
// buộc ghi rõ điều này để người dùng không hiểu nhầm là số liệu chính thức.
// ============================================================

model ContentDirection {
  id          String   @id @default(cuid())
  pageId      String
  workspaceId String?
  /// PILLAR | HOOK | TIME_BAND | MEDIA_KIND | SERVICE_AREA
  kind        String
  value       String
  /// EXPLORING | RISING | STABLE | DECLINING | EXHAUSTED
  status      String   @default("EXPLORING")
  /// Số bài dùng hướng này trong cửa sổ đánh giá
  sampleSize   Int      @default(0)
  avgScore     Float?
  prevAvgScore Float?
  /// % thay đổi so với kỳ trước (âm = đang tụt)
  changePct    Float?
  /// Ước lượng còn hiệu quả bao nhiêu ngày (kẹp 0–90). Null = chưa đủ dữ liệu.
  estLifeDays  Int?
  /// "Tăng tỉ trọng" | "Giữ nguyên" | "Giảm tỉ trọng" | "Tạm dừng hướng này"
  recommendation String?
  lastEvaluatedAt DateTime @db.Timestamptz(3)
  createdAt       DateTime @db.Timestamptz(3) @default(now())
  updatedAt       DateTime @db.Timestamptz(3) @updatedAt

  page FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, kind, value])
  @@index([pageId, status])
  @@index([workspaceId])
}

// ============================================================
// THÔNG BÁO CHO NGƯỜI DÙNG
//
// Ba nguồn: ACTIVITY (sự kiện bài viết của chính user: đăng thành
// công/thất bại, AutoPilot tạo bài chờ duyệt), ADMIN (admin gửi:
// duyệt/từ chối/reset mật khẩu/broadcast/bài viết mới), SYSTEM
// (hệ thống: chưa cấu hình AI/Pexels key...).
//
// Chỉ đánh dấu đã đọc, không xoá — lịch sử thông tin giữ nguyên.
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String // người nhận
  type      String // ACTIVITY | ADMIN | SYSTEM
  title     String
  body      String?
  link      String? // URL nội bộ để bấm tới (/history, /change-password...)
  read      Boolean  @default(false)
  createdAt DateTime @db.Timestamptz(3) @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

// ============================================================
// CẤU HÌNH THEO TỪNG USER
//
// Key AI (OpenAI-compatible) và Pexels là tài sản riêng của từng
// người dùng — không dùng chung, không fallback env. Value được
// mã hóa AES-256-GCM như AppSetting.
// ============================================================

model UserSetting {
  id        String   @id @default(cuid())
  userId    String
  key       String // "ai.baseUrl" | "ai.apiKey" | "ai.model" | "pexels.apiKey"
  value     String // đã mã hóa
  group     String // "AI" | "PEXELS"
  updatedAt DateTime @db.Timestamptz(3) @updatedAt
  createdAt DateTime @db.Timestamptz(3) @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// ============================================================
// TÀI LIỆU HƯỚNG DẪN / BẢNG TIN ADMIN
//
// Markdown thuần (renderer tự viết, escape mọi HTML). Admin tạo/sửa
// tại /admin; user đọc tại /docs. Chỉ Doc published hiện cho user.
// ============================================================

model Doc {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  bodyMarkdown  String
  published     Boolean  @default(false)
  /// Gửi thông báo cho mọi user khi publish?
  notifyOnPublish Boolean @default(false)
  authorId      String
  createdAt     DateTime @db.Timestamptz(3) @default(now())
  updatedAt     DateTime @db.Timestamptz(3) @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([published, updatedAt])
}

// ============================================================
// CÂU HỎI TƯƠNG TÁC — admin đặt câu hỏi cho người dùng
// (ý tưởng mới, cần góp ý...) để phát triển sản phẩm.
// Mỗi user trả lời 1 lần cho mỗi câu hỏi (upsert theo unique).
// ============================================================

model FeedbackQuestion {
  id        String   @id @default(cuid())
  question  String
  /// false = ẩn khỏi trang /docs nhưng giữ lại dữ liệu
  active    Boolean  @default(true)
  authorId  String
  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  author  User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answers FeedbackAnswer[]

  @@index([active, createdAt])
}

model FeedbackAnswer {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  body       String
  createdAt  DateTime @db.Timestamptz(3) @default(now())
  updatedAt  DateTime @db.Timestamptz(3) @updatedAt

  question FeedbackQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([userId])
}
